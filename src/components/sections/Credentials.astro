---
/**
 * Credentials (06 "Education & certifications") — black education card beside
 * a white card of certification StatPills (2-digit year as the number).
 */
import Pill from '@/components/game/Pill.astro';
import SectionHeader from '@/components/game/SectionHeader.astro';
import StatPill from '@/components/game/StatPill.astro';
import type { Certification, Education, Ui } from '@/lib/content';
import { formatMonth, formatYearRange, shortYear } from '@/lib/format';
import s from './Credentials.module.scss';

interface Props {
  ui: Ui;
  education: Education[];
  certifications: Certification[];
}

const { ui, education, certifications } = Astro.props;
const header = ui.sections.credentials;
const copy = ui.credentials;
const level = ui.player.level;
const pct = Math.min(100, Math.round((level.value / level.max) * 100));
---

<section id="credentials" class:list={['wrap', 'section']} aria-labelledby="credentials-title">
  <SectionHeader num={header.num} label={header.label} title={header.title} id="credentials-title" />

  <div class={s.grid}>
    {
      education.map((ed) => (
        <article class:list={[s.education, 'hf', 'hf-dark']}>
          <span class:list={[s.wm, 'wm']} aria-hidden="true">
            {copy.watermark}
          </span>
          <Pill tone="lime" hover="none">
            {copy.educationLabel}
          </Pill>
          <h3 class={s.degree}>{ed.degree}</h3>
          <p class={s.school}>{ed.school}</p>
          <p class={s.dates}>{formatYearRange(ed.start, ed.end)}</p>
          <div class={s.progress}>
            <span>
              {copy.progressLabel} Lv. {level.value} / {level.max}
            </span>
            <span
              class={s.bar}
              role="progressbar"
              aria-label={copy.progressLabel}
              aria-valuenow={level.value}
              aria-valuemin={0}
              aria-valuemax={level.max}
            >
              <span style={`width: ${pct}%`} />
            </span>
          </div>
        </article>
      ))
    }

    <article class:list={[s.certs, 'hr']}>
      <h3 class={s.certsTitle}>{copy.certificationsTitle}</h3>
      <ul class={s.certList}>
        {
          certifications.map((c) => (
            <li>
              <StatPill
                num={shortYear(c.date)}
                label={c.title}
                sub={`${c.issuer} · ${formatMonth(c.date)}`}
                href={c.url ?? undefined}
                class={s.cert}
              />
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>
