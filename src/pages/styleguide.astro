---
/**
 * /styleguide — TEMPORARY design-system reference (Phase 2).
 * Shows every token and game component. Unlisted + noindex.
 * Delete (or keep unlisted) in Phase 6.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionButton from '@/components/game/ActionButton';
import Chip from '@/components/game/Chip.astro';
import DateTag from '@/components/game/DateTag.astro';
import Highlight from '@/components/game/Highlight.astro';
import InfoTile from '@/components/game/InfoTile.astro';
import NameTag from '@/components/game/NameTag.astro';
import Pill from '@/components/game/Pill.astro';
import SectionHeader from '@/components/game/SectionHeader.astro';
import StatPill from '@/components/game/StatPill.astro';
import TechTag from '@/components/game/TechTag.astro';

const colors = [
  { name: '--ground', hex: '#EEF0F4', use: 'Page background, gray chips' },
  { name: '--card', hex: '#FFFFFF', use: 'Cards, nav bar' },
  { name: '--ink', hex: '#111214', use: 'Text, pills, tabs, dark cards' },
  { name: '--ink-2', hex: '#3A3F4A', use: 'Body copy on white' },
  { name: '--muted', hex: '#5A5F6B', use: 'Labels, captions' },
  { name: '--on-ink-muted', hex: '#C9CCD3', use: 'Secondary text on black' },
  { name: '--lime', hex: '#5CFF4A', use: 'Main accent' },
  { name: '--yellow', hex: '#FFC21A', use: 'Shapes, date & category tags' },
  { name: '--violet', hex: '#7B2FF7', use: 'Primary buttons' },
  { name: '--magenta', hex: '#E6338A', use: 'Project frame edge only' },
  { name: '--watermark', hex: '#DFE2E8', use: 'Giant faded numerals' },
  { name: '--line', hex: '#E1E4EA', use: 'Hairlines (shadcn --border)' },
  { name: '--holo', hex: 'gradient', use: 'Hover fills and rings' },
];

const fills = [
  { label: 'ink · .hf .hf-dark', cls: 'ink', fx: 'hf hf-dark' },
  { label: 'violet · .hf .hf-dark', cls: 'violet', fx: 'hf hf-dark' },
  { label: 'lime · .hf', cls: 'lime', fx: 'hf' },
  { label: 'yellow · .hf', cls: 'yellow', fx: 'hf' },
  { label: 'gray · .hf', cls: 'gray', fx: 'hf' },
  { label: 'white · .hr', cls: 'white', fx: 'hr' },
];
---

<BaseLayout title="Styleguide" description="Design system reference" noindex>
  <div class="wrap sg">
    <header class="intro">
      <p class="t-label">Temporary · Phase 2</p>
      <h1 class="t-h2">Styleguide</h1>
      <p class="t-body">
        Hover or Tab through anything below. Filled elements fade to the holo gradient; white ones get a holo
        outline. Turn on "reduce motion" in your OS to stop the shimmer and movement.
      </p>
    </header>

    <!-- ===== Colors ===== -->
    <section aria-labelledby="sg-colors">
      <SectionHeader num="01" label="Tokens" title="Colors" id="sg-colors" />
      <ul class="swatches">
        {
          colors.map((c) => (
            <li class="swatch">
              <span class="chip-color" style={`background: var(${c.name})`} />
              <code>{c.name}</code>
              <span class="hex">{c.hex}</span>
              <span class="use">{c.use}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ===== Typography ===== -->
    <section aria-labelledby="sg-type">
      <SectionHeader num="02" label="Outfit Variable" title="Typography" id="sg-type" />
      <div class="card stack">
        <p class="t-label">Display · 64–136 / 800</p>
        <p class="t-display">John<br />Lexter</p>
        <p class="t-label">H2 · 52 / 700</p>
        <p class="t-h2">Let's build something.</p>
        <p class="t-label">H3 · 23–30 / 700</p>
        <p class="t-h3">Software Developer Intern</p>
        <p class="t-label">Body large · 21</p>
        <p class="t-body-lg">Full-stack developer building secure, production-ready systems and data pipelines.</p>
        <p class="t-label">Body · 16</p>
        <p class="t-body">Built core HRIS modules in TypeScript, owning features from schema to UI.</p>
        <p class="t-label">Label · 14 / 600 / uppercase</p>
        <p class="t-label">Player profile</p>
        <p class="t-label">Outlined numeral · 96 / 800</p>
        <p class="t-numeral">04</p>
      </div>
    </section>

    <!-- ===== Shape ===== -->
    <section aria-labelledby="sg-shape">
      <SectionHeader num="03" label="Radius · cut · slant" title="Shape" id="sg-shape" />
      <div class="row">
        <div class="shape r-pill">999px pill</div>
        <div class="shape r-card">32px card</div>
        <div class="shape r-panel">44px panel</div>
        <div class="shape r-hl">14px highlight</div>
        <div class="shape cut">cut-corner 40px</div>
        <div class="shape cut-tr">cut-corner 26px tr</div>
        <div class="shape slant7">slant 7%</div>
        <div class="shape hexarrow" aria-label="Hexagon-arrow shape"></div>
        <div class="diamonds" aria-label="Diamonds">
          <span class="diamond"></span><span class="diamond"></span><span class="diamond"></span><span
            class="diamond outline"></span>
        </div>
      </div>
    </section>

    <!-- ===== Effects ===== -->
    <section aria-labelledby="sg-fx">
      <SectionHeader num="04" label="_effects.scss" title="Hover & focus" id="sg-fx" />
      <div class="fx-grid">
        {
          fills.map((f) => (
            <a href="#sg-fx" class:list={['fx', f.cls, f.fx]}>
              <span class="t-label fx-label">{f.label}</span>
              <span class="fx-title">Hover or focus me</span>
              <span class="fx-rule rule" />
              <span class="fx-wm wm" aria-hidden="true">
                CS
              </span>
            </a>
          ))
        }
      </div>
      <div class="row" style="margin-top: 24px">
        <a href="#sg-fx" class="card lift hr lift-demo">.lift .hr — card rises and tilts</a>
        <a href="#sg-fx" class="press-demo press hf">.press .hf — rises 2px</a>
      </div>
    </section>

    <!-- ===== Buttons (shadcn) ===== -->
    <section aria-labelledby="sg-buttons">
      <SectionHeader num="05" label="shadcn Button" title="Buttons" id="sg-buttons" />
      <div class="row">
        <ActionButton label="View projects" href="#sg-buttons" size="lg" icon="arrow-right" />
        <ActionButton label="Get in touch" href="#sg-buttons" size="lg" tone="secondary" />
        <ActionButton label="Download CV" href="#sg-buttons" icon="download" />
        <ActionButton label="hiterozalex@gmail.com" href="#sg-buttons" tone="ink" icon="mail" />
        <ActionButton label="Small" href="#sg-buttons" size="sm" tone="secondary" />
      </div>
    </section>

    <!-- ===== Game components ===== -->
    <section aria-labelledby="sg-game">
      <SectionHeader num="06" label="src/components/game" title="Components" id="sg-game">
        <Pill slot="action" href="#sg-game">All projects</Pill>
      </SectionHeader>

      <div class="stack">
        <h3 class="t-label">StatPill (count-up)</h3>
        <div class="row">
          <StatPill num={2} label="Internships" sub="Completed" countUp />
          <StatPill num={3} label="Projects" sub="Shipped" countUp />
          <StatPill num={3} label="Certifications" sub="Earned" countUp />
          <StatPill num={28} label="Skills" sub="Unlocked" countUp />
          <StatPill num="22" label="CS50x: Introduction to Computer Science" sub="edX · Dec 2022" />
        </div>

        <h3 class="t-label">NameTag · Highlight</h3>
        <div class="row">
          <NameTag>John Lexter</NameTag>
          <span class="t-h2"><Highlight>Software Developer</Highlight></span>
        </div>

        <h3 class="t-label">Chip · TechTag · DateTag</h3>
        <div class="card row">
          <Chip>TypeScript</Chip><Chip>PostgreSQL</Chip><Chip>Playwright</Chip>
          <TechTag>BigQuery</TechTag><TechTag>Cloud Run</TechTag>
          <DateTag>Apr 2026 – Jul 2026</DateTag>
        </div>

        <h3 class="t-label">Pill</h3>
        <div class="row">
          <Pill dot>Available for full-time roles</Pill>
          <Pill>Summary</Pill>
          <Pill tone="lime">Education</Pill>
          <Pill tone="gray" href="#sg-game">+ Full loadout</Pill>
          <Pill tone="white" href="#sg-game">White pill</Pill>
        </div>

        <h3 class="t-label">InfoTile</h3>
        <div class="tiles">
          <InfoTile variant="yellow" label="Base" title="San Pedro, Laguna" />
          <InfoTile variant="white" label="Academy" title="FEU Alabang">BS Computer Science · 2022–2026</InfoTile>
          <InfoTile variant="black" label="Status" title="Open to work" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style lang="scss">
  @use 'mixins' as *;

  .sg {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block: var(--space-7) var(--space-9);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 680px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .card {
    padding: var(--space-6);
    border-radius: var(--r-card);
    background: var(--card);
  }

  // Colors
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .swatch {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    border-radius: var(--r-card-sm);
    background: var(--card);
    font-size: 14px;

    code {
      font-weight: 600;
    }
  }

  .chip-color {
    height: 72px;
    margin-bottom: var(--space-2);
    border-radius: 18px;
    border: 1px solid var(--line);
  }

  .hex {
    color: var(--ink-2);
  }

  .use {
    color: var(--muted);
  }

  // Shapes
  .shape {
    display: grid;
    place-items: center;
    width: 150px;
    height: 100px;
    padding: var(--space-2);
    background: var(--yellow);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .r-pill {
    height: 56px;
    border-radius: var(--r-pill);
  }
  .r-card {
    border-radius: var(--r-card);
  }
  .r-panel {
    border-radius: var(--r-panel);
  }
  .r-hl {
    border-radius: var(--r-highlight);
    background: var(--lime);
    transform: rotate(-2deg);
  }
  .cut {
    background: #d9dde5;
    @include cut-corner(40px);
  }
  .cut-tr {
    @include cut-corner(26px, (tr));
  }
  .slant7 {
    background: var(--magenta);
    color: #fff;
    @include slant(7%);
  }
  .hexarrow {
    clip-path: polygon(28% 0, 100% 0, 74% 50%, 100% 100%, 28% 100%, 0 50%);
  }

  .diamonds {
    display: flex;
    gap: 14px;
  }

  .diamond {
    @include diamond(11px);

    &.outline {
      background: var(--lime);
      outline: 2px solid var(--ink);
    }
  }

  // Effects
  .fx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .fx {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 150px;
    padding: var(--space-5);
    border-radius: var(--r-card);
    overflow: hidden;
    color: var(--ink);
  }

  .fx-label {
    color: inherit;
    opacity: 0.85;
  }

  .fx-title {
    font-size: 22px;
    font-weight: 700;
  }

  .fx-rule {
    height: 1px;
    margin-top: auto;
    background: rgba(17, 18, 20, 0.2);
  }

  .fx-wm {
    position: absolute;
    right: 12px;
    bottom: -18px;
    font-size: 96px;
    font-weight: 800;
    line-height: 1;
    color: rgba(17, 18, 20, 0.06);
  }

  .ink,
  .violet {
    color: #fff;

    .fx-rule {
      background: rgba(255, 255, 255, 0.35);
    }
    .fx-wm {
      color: rgba(255, 255, 255, 0.08);
    }
  }

  .ink {
    background: var(--ink);
  }
  .violet {
    background: var(--violet);
  }
  .lime {
    background: var(--lime);
  }
  .yellow {
    background: var(--yellow);
  }
  .gray {
    background: var(--ground);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .white {
    background: var(--card);
  }

  .lift-demo {
    font-weight: 600;
  }

  .press-demo {
    padding: 14px 24px;
    border-radius: var(--r-pill);
    background: var(--lime);
    font-weight: 600;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }
</style>
